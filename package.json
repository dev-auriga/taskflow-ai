{
  "name": "taskflow",
  "version": "0.0.1",
  "private": true,
  "description": "TaskFlow — Full-stack Task Management Application",
  "scripts": {
    "========== DEVELOPMENT ==========": "",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @taskflow/api dev",
    "dev:web": "pnpm --filter @taskflow/web dev",
    "========== BUILD ==========": "",
    "build": "turbo run build",
    "build:api": "pnpm --filter @taskflow/api build",
    "build:web": "pnpm --filter @taskflow/web build",
    "build:shared": "pnpm --filter @taskflow/shared build",
    "========== QUALITY ==========": "",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "========== TESTING ==========": "",
    "test": "turbo run test",
    "test:shared": "pnpm --filter @taskflow/shared test",
    "test:api": "pnpm --filter @taskflow/api test",
    "test:web": "pnpm --filter @taskflow/web test",
    "test:e2e": "pnpm --filter @taskflow/web test:e2e",
    "test:e2e:headed": "pnpm --filter @taskflow/web test:e2e:headed",
    "========== DATABASE ==========": "",
    "db:start": "docker compose -f docker/docker-compose.dev.yml up -d",
    "db:stop": "docker compose -f docker/docker-compose.dev.yml down",
    "db:restart": "pnpm db:stop && pnpm db:start",
    "db:migrate": "pnpm --filter @taskflow/api prisma migrate dev",
    "db:migrate:reset": "pnpm --filter @taskflow/api prisma migrate reset --force",
    "db:seed": "pnpm --filter @taskflow/api prisma db seed",
    "db:studio": "pnpm --filter @taskflow/api prisma studio",
    "db:generate": "pnpm --filter @taskflow/api prisma generate",
    "db:push": "pnpm --filter @taskflow/api prisma db push",
    "========== INFRASTRUCTURE ==========": "",
    "infra:up": "pnpm db:start",
    "infra:down": "pnpm db:stop",
    "infra:status": "docker ps --filter name=taskflow --format 'table {{.Names}}\\t{{.Status}}\\t{{.Ports}}'",
    "infra:logs": "docker logs taskflow-db --tail 50",
    "========== DOCKER (PRODUCTION) ==========": "",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker/docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker/docker-compose.prod.yml logs -f",
    "========== SETUP ==========": "",
    "setup": "pnpm install && pnpm db:start && sleep 3 && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "setup:clean": "pnpm db:stop && docker volume rm docker_taskflow_pgdata 2>/dev/null; pnpm setup",
    "========== SERVICES ==========": "",
    "services:start": "pnpm db:start && echo 'DB started on port 5434' && echo 'Run pnpm dev to start API (3001) + Web (3000)'",
    "services:stop": "pnpm db:stop && echo 'All services stopped'",
    "services:status": "echo '--- Docker Containers ---' && docker ps --filter name=taskflow --format 'table {{.Names}}\\t{{.Status}}\\t{{.Ports}}' && echo '' && echo '--- Ports in use ---' && ss -tlnp 2>/dev/null | grep -E '300[01]|5434' || true",
    "========== OPENAPI / POSTMAN ==========": "",
    "generate:openapi": "pnpm --filter @taskflow/api generate:openapi",
    "========== DOCTOR (HEALTH CHECK) ==========": "",
    "doctor": "echo '🔍 TaskFlow Doctor' && echo '' && echo '--- Node ---' && node --version && echo '--- pnpm ---' && pnpm --version && echo '--- Docker ---' && docker --version && echo '' && echo '--- Database ---' && docker exec taskflow-db pg_isready -U taskflow 2>/dev/null || echo '❌ Database not running (run: pnpm db:start)' && echo '' && echo '--- TypeScript ---' && pnpm typecheck 2>&1 | tail -1 && echo '' && echo '--- Ports ---' && ss -tlnp 2>/dev/null | grep -E '300[01]|5434' || echo 'No services detected on expected ports'",
    "========== UTILITIES ==========": "",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/web/.next apps/api/dist",
    "clean:turbo": "rm -rf .turbo apps/*/.turbo",
    "reset": "pnpm clean && pnpm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
