    },
    {
      "name": "tasks",
      "description": "Task management endpoints"
    },
    {
      "name": "dashboard",
      "description": "Dashboard statistics endpoints"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "schemas": {}
  }
}